<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <path
        android:pathData="M100,100 m-95,0 a95,95 0 1,0 190,0 a95,95 0 1,0 -190,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="95"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFBF2"/>
                <item android:offset="0.7" android:color="#F7EED9"/>
                <item android:offset="1.0" android:color="#EEDEB8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Nose Ring Loop -->
    <path
        android:strokeWidth="5"
        android:pathData="M80,100 m-36,0 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="44"
                android:startY="64"
                android:endX="116"
                android:endY="136"
                android:type="linear">
                <item android:offset="0.0" android:color="#8A682C"/>
                <item android:offset="0.5" android:color="#D4AF37"/>
                <item android:offset="1.0" android:color="#8A682C"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ornate Ruby Cluster on Nose Ring Outer Edge -->
    <path android:pathData="M116,100 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" android:fillColor="#C41E3A"/>
    <path android:pathData="M116,86 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#D4AF37"/>
    <path android:pathData="M116,114 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#D4AF37"/>

    <!-- Pearl Hair Chain Extending to Right -->
    <path
        android:strokeWidth="2.5"
        android:pathData="M124,100 C145,100 155,75 175,55"
        android:strokeColor="#8A682C"/>

    <path android:pathData="M138,92 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" android:fillColor="#F8F8FF"/>
    <path android:pathData="M152,78 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" android:fillColor="#F8F8FF"/>
    <path android:pathData="M166,64 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" android:fillColor="#F8F8FF"/>
</vector>
