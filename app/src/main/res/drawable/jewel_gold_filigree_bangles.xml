<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <path
        android:pathData="M100,100 m-95,0 a95,95 0 1,0 190,0 a95,95 0 1,0 -190,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="95"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFBF2"/>
                <item android:offset="0.7" android:color="#F7EED9"/>
                <item android:offset="1.0" android:color="#EEDEB8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- First Bangle (Behind) -->
    <path
        android:strokeWidth="14"
        android:pathData="M88,95 m-52,0 a52,52 0 1,0 104,0 a52,52 0 1,0 -104,0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="36"
                android:startY="43"
                android:endX="140"
                android:endY="147"
                android:type="linear">
                <item android:offset="0.0" android:color="#8A682C"/>
                <item android:offset="0.5" android:color="#D4AF37"/>
                <item android:offset="1.0" android:color="#8A682C"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Second Bangle (In Front) -->
    <path
        android:strokeWidth="14"
        android:pathData="M112,108 m-52,0 a52,52 0 1,0 104,0 a52,52 0 1,0 -104,0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="60"
                android:startY="56"
                android:endX="164"
                android:endY="160"
                android:type="linear">
                <item android:offset="0.0" android:color="#8A682C"/>
                <item android:offset="0.3" android:color="#FFF3D4"/>
                <item android:offset="0.7" android:color="#D4AF37"/>
                <item android:offset="1.0" android:color="#8A682C"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Filigree Floral Accents on Rim -->
    <path android:pathData="M112,54 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#C41E3A"/>
    <path android:pathData="M164,108 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#C41E3A"/>
    <path android:pathData="M112,162 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#C41E3A"/>
    <path android:pathData="M60,108 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#C41E3A"/>
</vector>
