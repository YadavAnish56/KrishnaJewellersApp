<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <path
        android:pathData="M100,100 m-95,0 a95,95 0 1,0 190,0 a95,95 0 1,0 -190,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="95"
                android:type="radial">
                <item android:offset="0.0" android:color="#F8FAFC"/>
                <item android:offset="0.7" android:color="#ECEFF2"/>
                <item android:offset="1.0" android:color="#DEE3E8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Silver Ring Band -->
    <path
        android:strokeWidth="14"
        android:pathData="M100,115 m-46,0 a46,46 0 1,0 92,0 a46,46 0 1,0 -92,0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="50"
                android:startY="65"
                android:endX="150"
                android:endY="165"
                android:type="linear">
                <item android:offset="0.0" android:color="#717D8A"/>
                <item android:offset="0.4" android:color="#FFFFFF"/>
                <item android:offset="0.7" android:color="#B0B9C2"/>
                <item android:offset="1.0" android:color="#717D8A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crown Setting -->
    <path
        android:pathData="M84,65 L100,45 L116,65 L108,70 L100,58 L92,70 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Princess Center Solitaire -->
    <path
        android:pathData="M92,48 L108,48 L114,56 L100,72 L86,56 Z"
        android:fillColor="#E6F2FF"/>
</vector>
