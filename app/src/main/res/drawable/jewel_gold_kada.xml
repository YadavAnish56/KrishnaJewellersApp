<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <path
        android:pathData="M100,100 m-95,0 a95,95 0 1,0 190,0 a95,95 0 1,0 -190,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="95"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFBF2"/>
                <item android:offset="0.7" android:color="#F7EED9"/>
                <item android:offset="1.0" android:color="#EEDEB8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Thick Gents Kada Solid Ring -->
    <path
        android:strokeWidth="24"
        android:pathData="M100,105 m-50,0 a50,50 0 1,0 100,0 a50,50 0 1,0 -100,0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="35"
                android:startY="40"
                android:endX="165"
                android:endY="170"
                android:type="linear">
                <item android:offset="0.0" android:color="#8A682C"/>
                <item android:offset="0.3" android:color="#FFF9EE"/>
                <item android:offset="0.7" android:color="#D4AF37"/>
                <item android:offset="1.0" android:color="#8A682C"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Carved Terminals at Gap/Closure -->
    <path android:pathData="M92,42 L108,42 L105,62 L95,62 Z" android:fillColor="#8A682C"/>
    <path android:pathData="M95,45 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#D4AF37"/>
    <path android:pathData="M105,45 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#D4AF37"/>
</vector>
